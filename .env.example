# Copy to .env and adjust as needed.
#
# The calculation engines require no secrets. The Lighthouse cross-product
# integration below does — but every flag defaults to DISABLED and nothing in
# this file is wired into a running route today.

# Port the HTTP server listens on. Must be an integer 1-65535.
# Defaults to 3001 if unset.
PORT=3001

# ---------------------------------------------------------------------------
# Lighthouse cross-product feature flags
# ---------------------------------------------------------------------------
# ALL DEFAULT TO DISABLED. Only the exact string "true" enables a flag; "1",
# "yes" and "on" are treated as disabled on purpose.
#
# A flag NEVER bypasses authorization. Enabling one only makes an already fully
# authorized flow reachable — see src/lighthouse/domain/policy.ts.
#
# Do NOT enable any of these without the corresponding Relationship OS contract
# being agreed, the endpoint deployed, and a review sign-off.

# Stage 1 — secure launch receiver, redemption, result callback.
# Blocked on: a database + secret manager in this service, and confirmation of
# the launch-context response shape from Relationship OS.
LIGHTHOUSE_FF_STAGE1_LAUNCH_RECEIVER=false

# Stage 2 — cross-product identity linking. Blocked on Relationship OS
# implementing matching invitation/confirmation endpoints.
LIGHTHOUSE_FF_CROSS_PRODUCT_IDENTITY_LINKING=false

# Stage 3 — coarse client workspace availability disclosure (consent-gated).
LIGHTHOUSE_FF_CLIENT_WORKSPACE_DISCLOSURE=false

# Stage 4 — client-selected analysis sharing.
LIGHTHOUSE_FF_SELECTED_ANALYSIS_SHARING=false

# Stage 5 — professional connectivity projection.
LIGHTHOUSE_FF_PROFESSIONAL_CONNECTIVITY_PROJECTION=false

# Stage 6 — cross-product lifecycle/outbox synchronization.
LIGHTHOUSE_FF_LIFECYCLE_SYNCHRONIZATION=false

# Stage 7 — cross-product administration surfaces.
LIGHTHOUSE_FF_CROSS_PRODUCT_ADMINISTRATION=false

# Stage 8 — delegated client portfolio management (Mode D).
# Blocked on 8 unresolved product decisions in
# DELEGATED_CLIENT_INVESTSCAPE_MANAGEMENT_SCOPE_V0.1.
LIGHTHOUSE_FF_DELEGATED_PORTFOLIO_MANAGEMENT=false

# Stage 8 extension — assisted consent.
# Blocked on legal/compliance review. Do not enable.
LIGHTHOUSE_FF_ASSISTED_CONSENT=false

# Lighthouse suite entitlement synchronization.
# Blocked on 11 unresolved commercial decisions in
# UNIFIED_LIGHTHOUSE_SUITE_SUBSCRIPTION_SCOPE_V0.1.
LIGHTHOUSE_FF_SUITE_ENTITLEMENT_SYNC=false

# ---------------------------------------------------------------------------
# Relationship OS service-to-service credentials — DIRECTIONAL
# ---------------------------------------------------------------------------
# Real credentials were issued 2026-09-02 into the gitignored .env. The values
# below are STRUCTURE ONLY — never put real key material in this file.
#
# Per the 2026-09-02 architecture review (P1): "Do not issue one bidirectional
# HMAC secret. Use independent environment-specific credentials for
# Relationship OS -> InvestScape and InvestScape -> Relationship OS."
#
# Two independent 32-byte secrets exist. Each service holds both, in mirrored
# roles, so a key compromised in one direction cannot forge the other:
#
#   InvestScape        INBOUND  = verify from Relationship OS  (key ros-to-is-*)
#                      OUTBOUND = sign to Relationship OS      (key is-to-ros-*)
#   Relationship OS    INBOUND  = verify from InvestScape      (key is-to-ros-*)
#                      OUTBOUND = sign to InvestScape          (key ros-to-is-*)
#
# HMAC canonicalization (pinned to the Relationship OS implementation, and
# reproduced byte-for-byte by our golden-vector test):
#   base      = METHOD \n path \n timestamp \n nonce \n sha256(rawBody).hex
#   signature = HMAC-SHA256(secret, base) -> lowercase hex
#   headers   = x-lighthouse-{service,key-id,timestamp,nonce,signature}
#   skew      = +/- 300s, nonce >= 32 hex chars, replay-protected
#
# ROTATION: the verifier selects a secret BY KEY ID, so current and next keys
# can coexist. Add _NEXT_ variants, deploy to both services, cut the outbound
# key id over, then retire the old pair.

LIGHTHOUSE_SVC_INBOUND_KEY_ID=ros-to-is-YYYYMM-a
LIGHTHOUSE_SVC_INBOUND_SECRET=<64-hex-chars — see .env, never commit>

LIGHTHOUSE_SVC_OUTBOUND_KEY_ID=is-to-ros-YYYYMM-a
LIGHTHOUSE_SVC_OUTBOUND_SECRET=<64-hex-chars — see .env, never commit>

# Optional overlapping keys during rotation.
# LIGHTHOUSE_SVC_INBOUND_NEXT_KEY_ID=
# LIGHTHOUSE_SVC_INBOUND_NEXT_SECRET=

# Base origin of the Relationship OS API. Must be https:// outside localhost.
# Left unset until Relationship OS is deployed — the redemption client returns
# 'unconfigured' and fails closed rather than calling a guessed URL.
# RELATIONSHIP_OS_BASE_URL=

# ---------------------------------------------------------------------------
# Database (Supabase / Postgres)
# ---------------------------------------------------------------------------
# Required before the Stage 1 receiver can hold a launch-session binding, a
# replay nonce, or an audit row. Absent this, the lighthouse repositories fall
# back to in-memory implementations that are UNSAFE multi-process and are for
# tests and local development only.
#
# Use the session-pooler / direct connection string, not the browser anon key.
# The anon key must never appear in this service.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Set to "true" ONLY in local development to allow the in-memory repository
# fallback. In any deployed environment this must be unset so a missing
# DATABASE_URL fails closed instead of silently running without persistence.
LIGHTHOUSE_ALLOW_INMEMORY_PERSISTENCE=false
